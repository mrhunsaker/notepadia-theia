  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/notepadia-frontend-module"
