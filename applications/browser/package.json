{
  "private": true,
  "name": "notepadia-browser-app",
  "description": "Notepadia browser application",
  "productName": "Notepadia",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "yarn": ">=1.7.0 <2"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Notepadia",
        "reloadOnReconnect": true,
        "preferences": {
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false,
          "workbench.colorTheme": "Notepadia Classic",
          "editor.fontFamily": "Consolas, 'Courier New', 'DejaVu Sans Mono', monospace",
          "editor.fontSize": 13,
          "editor.lineHeight": 0,
          "breadcrumbs.enabled": false,
          "editor.minimap.enabled": false,
          "editor.glyphMargin": true,
          "editor.folding": true,
          "editor.renderLineHighlight": "line",
          "editor.occurrencesHighlight": "off",
          "editor.lightbulb.enabled": "off",
          "editor.suggest.showWords": false,
          "editor.scrollBeyondLastLine": false,
          "editor.roundedSelection": false
        }
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": 3000,
        "startupTimeout": -1,
        "resolveSystemPlugins": false,
        "configurationFolder": ".notepadia"
      }
    }
  },
  "dependencies": {
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/editor-preview": "1.75.0",
    "@theia/file-search": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/keymaps": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/search-in-workspace": "1.75.0",
    "@theia/workspace": "1.75.0",
    "notepadia": "0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0",
    "rimraf": "^2.7.1"
  },
  "scripts": {
    "build": "yarn -s rebuild && theia build --app-target=browser --mode development",
    "build:prod": "yarn -s rebuild && theia build --app-target=browser",
    "rebuild": "theia rebuild:browser --cacheRoot ../..",
    "start": "theia start --app-target=browser",
    "start:debug": "theia start --app-target=browser --log-level=debug",
    "watch": "theia build --app-target=browser --mode development --watch",
    "clean": "theia clean && rimraf node_modules",
    "clean:dist": "rimraf dist"
  }
}
